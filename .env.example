# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Pin one free model, e.g. some-author/some-model:free.
# Leave unset to use OpenRouter's free router, which picks one at random per request.
OPENROUTER_MODEL=

# Optional locally, required in production. The site's own origin, used for
# canonical URLs, Open Graph image URLs, and OpenRouter traffic attribution.
NEXT_PUBLIC_SITE_URL=
